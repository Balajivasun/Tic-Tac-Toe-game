import java.util.*;

public class TTT {
    static char[][] b = {{' ',' ',' '},{' ',' ',' '},{' ',' ',' '}};
    static char p = 'X';

    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        while (true) {
            for (char[] r : b) System.out.println(Arrays.toString(r));
            System.out.print("Player " + p + " (row col): ");
            int r = s.nextInt(), c = s.nextInt();
            if (b[r][c] != ' ') continue;
            b[r][c] = p;
            if (w()) { System.out.println("Player " + p + " wins!"); break; }
            if (d()) { System.out.println("Draw!"); break; }
            p = (p == 'X') ? 'O' : 'X';
        }
    }

    static boolean w() {
        for (int i = 0; i < 3; i++)
            if ((b[i][0]==p && b[i][1]==p && b[i][2]==p) || (b[0][i]==p && b[1][i]==p && b[2][i]==p))
                return true;
        return (b[0][0]==p && b[1][1]==p && b[2][2]==p) || (b[0][2]==p && b[1][1]==p && b[2][0]==p);
    }

    static boolean d() {
        for (char[] r : b) for (char c : r) if (c == ' ') return false;
        return true;
    }
}
